# ── Tietokanta ─────────────────────────────────────────────────────────────
# Jos nämä puuttuvat, sovellus toimii DEMO-tilassa (paikallinen .data/db.json).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM Smart Importia varten (valinnainen) ────────────────────────────────
# provider: anthropic | openai | heuristic (oletus ilman avainta: heuristic)
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── PDF-export (valinnainen) ───────────────────────────────────────────────
# Polku Chrome/Chromium-binääriin Playwrightia varten.
# Ilman tätä PDF tehdään selaimen omalla Tulosta → Tallenna PDF -toiminnolla.
PDF_CHROME_PATH=
